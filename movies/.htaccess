# ---------------------------------------------------------------
# 動画フォルダ : スクリプトの実行を禁止する
# 万一 .php などがアップロードされても実行されないようにするための保険。
# ---------------------------------------------------------------

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php[0-9]|phtml|phar|cgi|pl|py|rb|sh|html?|htm)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
